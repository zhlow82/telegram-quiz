{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Auth Service",
      "presentation": { "order": 2 },
      "request": "launch",
      "noDebug": true,
      "mainClass": "com.telegramquiz.auth.AuthServiceApplication",
      "projectName": "auth-service",
      "vmArgs": "-Dspring.devtools.restart.enabled=false",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "java",
      "name": "Main Service",
      "presentation": { "order": 3 },
      "request": "launch",
      "noDebug": true,
      "mainClass": "com.telegramquiz.main.MainServiceApplication",
      "projectName": "main-service",
      "vmArgs": "-Dspring.devtools.restart.enabled=false",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "java",
      "name": "API Gateway",
      "presentation": { "order": 4 },
      "request": "launch",
      "noDebug": true,
      "mainClass": "com.telegramquiz.gateway.GatewayApplication",
      "projectName": "api-gateway",
      "vmArgs": "-Dspring.devtools.restart.enabled=false",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "name": "Frontend",
      "presentation": { "order": 5 },
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/src/frontend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": ["Auth Service", "Main Service", "API Gateway", "Frontend"],
      "stopAll": true,
      "presentation": { "order": 1 }
    }
  ]
}
